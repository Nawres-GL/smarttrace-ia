+/* V4 — readable responses and expandable evidence instead of diagnostic dumps */
+.rag-v4-response { font-size:14px; line-height:1.75; white-space:pre-line; color:#244536;
+  border-left:3px solid #31926b; padding:6px 12px; margin:8px 0 12px; }
+.rag-v4-tablewrap {overflow:auto; max-width:min(780px, 100%); background:white;
+  border:1px solid #dce9e1; border-radius:12px; margin:9px 0 12px; }
+.rag-v4-table {border-collapse:collapse; width:100%; font-size:13px; min-width:410px; }
+.rag-v4-table th {text-align:left; background:#edf7f0; color:#23533c;
+  font-size:12px; padding:10px; border-bottom:1px solid #dbe9df; }
+.rag-v4-table td {padding:9px 10px; border-bottom:1px solid #edf2ef; }
+.rag-v4-table tbody tr:last-child td {border-bottom:none;}
+.rag-v4-table tbody tr:hover {background:#f8fcf9;}
+.rag-v4-number {font-weight:750; font-variant-numeric:tabular-nums; color:#17784c;}
+.rag-v4-panel h4 {font-size:13px; margin:16px 0 6px; color:#275740;}
+.rag-v4-provenance {display:flex; flex-wrap:wrap; gap:5px 12px; margin-top:10px;
+  font-size:12px; color:#627568;}
+.rag-v4-provenance strong {color:#2a6748;}
+.rag-v4-warnings {margin-top:10px; font-size:12px; color:#815b22;}
+.rag-v4-warnings summary {cursor:pointer; font-weight:600;}
+.rag-v4-warnings ul {padding-left:18px; margin:6px 0;}
+.rag-v4-response, .rag-v4-panel {overflow-wrap:anywhere;}
+
+.rag-v4-explore-link {margin-top:12px;padding:9px 12px;border:1px solid #a5cbb2;
+  border-radius:9px;background:white;color:#196b43;cursor:pointer;font-size:12px;font-weight:700;}
+.rag-v4-explore-link:hover {background:#edf8f0;}
